# Use scripts/db.ps1 init to generate an ignored .env with a random password.
POSTGRES_DB=jobhunt
POSTGRES_USER=jobhunt_local
POSTGRES_PASSWORD=replace_with_a_random_local_password
POSTGRES_PORT=45432

# Web/API ports are implemented; worker/Redis ports are reserved for Phase 3.
WEB_PORT=43170
API_PORT=43171
WORKER_HEALTH_PORT=43172
REDIS_PORT=46379
SESSION_SECRET=replace_with_a_random_session_secret
OWNER_PASSWORD=replace_with_a_random_owner_password
WEB_ORIGIN=http://127.0.0.1:43170

# Host applications connect to 127.0.0.1:45432.
# Container applications connect to postgres:5432 on the Compose network.
# Application configuration builds DATABASE_URL from these settings; do not commit credentials.
