{
  "name": "job-search-os",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jobhunt/analytics build && pnpm --parallel --filter @jobhunt/api --filter @jobhunt/web dev",
    "build": "pnpm --filter @jobhunt/analytics build && pnpm --filter @jobhunt/api build && pnpm --filter @jobhunt/web build",
    "typecheck": "pnpm --filter @jobhunt/analytics build && pnpm -r --if-present typecheck",
    "lint": "eslint apps packages tests scripts --ignore-pattern '**/generated/**'",
    "test": "pnpm --filter @jobhunt/analytics build && node scripts/test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "db:generate": "pnpm --filter @jobhunt/api db:generate",
    "db:migrate": "pnpm --filter @jobhunt/api db:migrate",
    "test:unit": "pnpm --filter @jobhunt/analytics build && vitest run --project unit",
    "test:coverage": "pnpm --filter @jobhunt/analytics build && node scripts/test.mjs --coverage",
    "test:all": "pnpm test:coverage && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/react": "16.3.3",
    "@vitest/coverage-v8": "5.0.3",
    "dotenv": "18.0.5",
    "eslint": "10.12.0",
    "jsdom": "30.1.3",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
