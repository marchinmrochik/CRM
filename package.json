{
  "name": "job-search-os",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @jobhunt/api --filter @jobhunt/web dev",
    "build": "pnpm --filter @jobhunt/api build && pnpm --filter @jobhunt/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint apps tests scripts --ignore-pattern '**/generated/**'",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @jobhunt/api db:generate",
    "db:migrate": "pnpm --filter @jobhunt/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "dotenv": "18.0.5",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
